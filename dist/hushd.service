[Unit]
Description=Hush daemon (virtual microphone with noise suppression)
Documentation=https://github.com/BxnnyG/hush
After=pipewire.service wireplumber.service
Wants=pipewire.service

[Service]
Type=dbus
BusName=io.github.bxnnyg.Hush
ExecStart=/usr/bin/hushd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
